# Переменные docker compose. ВСЕ необязательные: без .env проект поднимается целиком локально
# (Postgres, Redis, Meilisearch, S3 в LocalStack). Скопируйте в .env только то, что меняете.

# Публичные адреса, по которым БРАУЗЕР ходит к фронту и API (API_URL вшивается в сборку фронта)
FRONT_URL=http://localhost:3001
API_URL=http://localhost:4000

# Секреты — обязательно поменять на сервере
JWT_CAPTCHA_SECRET=change-me-captcha-secret-in-production
JWT_VOTER_SECRET=change-me-voter-secret-in-production
MEILI_MASTER_KEY=change-me-meili-master-key
POSTGRES_PASSWORD=comments
API_DOCS_ENABLED=true

# Порты на хосте (если заняты — поменяйте)
FRONT_HOST_PORT=3001
BACK_HOST_PORT=4000
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
MEILI_HOST_PORT=7702
S3_HOST_PORT=4566

# ---- Внешнее S3 вместо LocalStack (DigitalOcean Spaces / AWS) ----
# В CORS бакета разрешите PUT, GET, HEAD с FRONT_URL и откройте заголовок ETag.
# S3_REGION=ams3
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com
# S3_PUBLIC_ENDPOINT=https://ams3.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=false
# S3_BUCKET_NAME=your-bucket
# S3_FOLDER=comments/prod
# S3_CDN_URL=https://your-bucket.ams3.cdn.digitaloceanspaces.com/
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
