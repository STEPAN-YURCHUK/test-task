# Вкладка Environment сайта в Forge. Для test-task.pp.ua можно вставить как есть — больше ничего заполнять не нужно.
# Пароль Postgres, JWT-секреты, ключ Meilisearch и ключи хранилища deploy-скрипт генерирует сам при первом деплое
# (файл /home/forge/test-task.pp.ua/.docker-secrets.env, права 600).

# Адреса: фронт, API и файлы на одном домене (nginx: /api и /socket.io → бэкенд, /storage → хранилище)
FRONT_URL=https://test-task.pp.ua
API_URL=https://test-task.pp.ua
API_DOCS_ENABLED=true

# Порты контейнеров на 127.0.0.1 — на них смотрит nginx (nginx.conf)
FRONT_HOST_PORT=4008
BACK_HOST_PORT=4009
STORAGE_HOST_PORT=4010
