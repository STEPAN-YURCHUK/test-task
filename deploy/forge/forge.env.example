# Шаблон для вкладки Environment сайта в Forge. Один файл на бэкенд и фронт:
# деплой-скрипт линкует его в back/.production.env и front/.env.production.
# Секреты сгенерировать: openssl rand -hex 32

# ---- Адреса ----
# фронт и API на одном домене: nginx отдаёт /api и /socket.io бэкенду
NEXT_PUBLIC_API_URL=https://test-task.pp.ua
CORS_ORIGINS=https://test-task.pp.ua
# порт бэкенда (фронт слушает 4008 — задан в PM2-конфиге)
PORT=4009
API_DOCS_ENABLED=true

# ---- PostgreSQL (Forge → Databases: создать базу comments; пароль forge — из письма о создании сервера) ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=forge
POSTGRES_PASSWORD=
POSTGRES_DB=comments
# схема создаётся при старте (миграций нет)
DB_SYNCHRONIZE=true

# ---- Redis (ставится Forge по умолчанию) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_CAPTCHA_SECRET=
JWT_CAPTCHA_TIME=5m
JWT_VOTER_SECRET=
JWT_VOTER_TIME=365d

# ---- Meilisearch (демон на этом же сервере, см. README → Деплой на Forge) ----
# без него список читается из Postgres — приложение работает, но медленнее
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=

# ---- S3 (DigitalOcean Spaces / AWS / Cloudflare R2) ----
# CORS бакета: разрешить PUT, GET, HEAD с https://test-task.pp.ua и открыть заголовок ETag
S3_REGION=ams3
S3_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_PUBLIC_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_FORCE_PATH_STYLE=false
S3_BUCKET_NAME=
S3_FOLDER=comments/prod
S3_CDN_URL=https://<bucket>.ams3.cdn.digitaloceanspaces.com/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ffmpeg/ffprobe (перекодирование видео) — по умолчанию из PATH: sudo apt-get install -y ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
