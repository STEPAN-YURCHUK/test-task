PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_DOCS_ENABLED=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments
POSTGRES_DB=comments
DB_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

JWT_CAPTCHA_SECRET=change-me-captcha-secret
JWT_CAPTCHA_TIME=5m


JWT_VOTER_SECRET=change-me-voter-secret
JWT_VOTER_TIME=365d

MEILI_HOST=http://localhost:7702
MEILI_MASTER_KEY=change-me-meili-master-key

# S3: по умолчанию LocalStack из docker compose (docker compose up -d s3) — работает без ключей.
# Для DigitalOcean Spaces: S3_REGION=ams3, S3_ENDPOINT=https://ams3.digitaloceanspaces.com, S3_FORCE_PATH_STYLE=false,
# свой бакет, S3_CDN_URL=https://<bucket>.ams3.cdn.digitaloceanspaces.com/ и ключи доступа
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=comments
S3_FOLDER=comments/dev
S3_CDN_URL=http://localhost:4566/comments/
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
