
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments
DB_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

JWT_CAPTCHA_SECRET=change-me-captcha-secret
JWT_CAPTCHA_TIME=5m


JWT_VOTER_SECRET=change-me-voter-secret
JWT_VOTER_TIME=365d

MEILI_HOST=http://localhost:7702
MEILI_MASTER_KEY=change-me-meili-master-key

# e2e подменяют S3 хранилищем в памяти — значения ниже нигде не используются для запросов
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=comments
S3_CDN_URL=http://localhost:4566/comments/
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
PORT=4100
CORS_ORIGINS=http://localhost:3101
POSTGRES_DB=comments_test
# изоляция от dev: своя Redis DB (очереди Bull, кеш, сессии) и свой индекс Meilisearch
REDIS_DB=1
MEILI_INDEX_PREFIX=test_
S3_FOLDER=comments/e2e
# фиксированный текст капчи — работает только при NODE_ENV != production
CAPTCHA_FIXED_TEXT=e2e123
THROTTLE_DISABLED=true
# списки временных почт не качаются из сети (тесты детерминированы, без GitHub)
DISPOSABLE_EMAIL_AUTO_REFRESH=false
